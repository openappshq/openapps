{
  "name": "openapps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @openapps/website dev",
    "build": "pnpm --filter @openapps/website build",
    "preview": "pnpm --filter @openapps/website preview",
    "site:dev": "pnpm --filter @openapps/site-worker dev",
    "site:test": "pnpm --filter @openapps/site-worker test",
    "lint": "vp lint",
    "test": "vp test run",
    "theme": "node scripts/generate-theme.mjs",
    "design:check": "node scripts/check-design.mjs",
    "keyboard:assets": "node scripts/build-keyboard-assets.mjs",
    "dmg:backgrounds": "node scripts/build-dmg-backgrounds.mjs",
    "openklack:dev": "pnpm --filter @openapps/openklack-desktop dev",
    "openklack:build": "pnpm --filter @openapps/openklack-desktop build",
    "openklack:test": "cargo test --manifest-path apps/openklack-desktop/src-tauri/Cargo.toml",
    "openklack:icons": "node scripts/generate-desktop-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  }
}
