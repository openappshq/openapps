<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the signed Hertz.app (scripts/bundle.sh).

  The app is not sandboxed: the process table (libproc), IOKit power and
  battery registries, the AppleSMC user client and the Cleanup Scout's file
  access are unavailable to a sandboxed process. The hardened runtime is
  enabled on the codesign command line with no exceptions: Hertz loads no
  frameworks, plug-ins or JIT, and asks macOS for no permissions.
-->
<plist version="1.0">
<dict>
</dict>
</plist>
