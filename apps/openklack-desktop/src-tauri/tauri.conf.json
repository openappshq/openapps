{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKlack",
  "version": "0.1.0",
  "identifier": "com.openklack.desktop",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "beforeBuildCommand": "pnpm web:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost; worker-src blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "Utility",
    "shortDescription": "Mechanical keyboard sound, everywhere you type.",
    "resources": { "../../../packages/soundpacks/sounds/": "sounds/", "../../../packages/soundpacks/catalog.json": "soundpacks.json" },
    "macOS": { "minimumSystemVersion": "14.0", "infoPlist": "Info.plist" }
  }
}
