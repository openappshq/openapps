<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the signed OpenReaction.app (scripts/bundle.sh).

  The app is not sandboxed, because the session event tap and the
  Accessibility queries it makes into other apps are unavailable to a
  sandboxed process. The hardened runtime is enabled on the codesign command
  line. Its one exception here is library validation: the runtime only loads
  frameworks signed by Apple or by the app's own Team ID, and a self-signed
  release certificate (RELEASES.md) has no Team ID, so the embedded
  Sparkle.framework of official builds would be refused without it. The app
  loads no plug-ins, no other libraries and no JIT. Accessibility and Input
  Monitoring are user grants in System Settings, not entitlements.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
