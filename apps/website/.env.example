# Each app installs from its install script (`curl -fsSL
# https://openapps.space/install/<app> | sh`) or as a Homebrew cask from the
# openappshq/homebrew-tap tap; both are published together (see RELEASES.md).
# Set the cask as owner/tap/name once it exists; the site then shows the
# install command with `brew install --cask <cask>` as the alternative, and
# Buy goes live (with the paid product ID below). Unset it to pull the app:
# there is no on/off list in code.
VITE_OPENKLACK_BREW_CASK=
VITE_OPENREACTION_BREW_CASK=
VITE_HERTZ_BREW_CASK=
VITE_MACPAPER_BREW_CASK=

# Optional: a public, signed installer URL (https) shown as a direct download
# beside the brew command. It never enables Buy on its own.
VITE_OPENKLACK_MAC_DOWNLOAD_URL=
VITE_OPENREACTION_MAC_DOWNLOAD_URL=
VITE_HERTZ_MAC_DOWNLOAD_URL=
VITE_MACPAPER_MAC_DOWNLOAD_URL=

# Dodo Payments static checkout. Product IDs are public (they appear in every
# checkout link); no Dodo API key belongs here. "Buy" is unavailable unless
# the app's paid product ID and cask are both set. Trials start in the app,
# so there is no trial product.
# Leave the origin unset for live; use https://test.checkout.dodopayments.com
# with test-mode product IDs in previews.
VITE_DODO_CHECKOUT_ORIGIN=
VITE_OPENREACTION_DODO_PAID_PRODUCT_ID=
VITE_OPENKLACK_DODO_PAID_PRODUCT_ID=
VITE_HERTZ_DODO_PAID_PRODUCT_ID=
VITE_MACPAPER_DODO_PAID_PRODUCT_ID=
