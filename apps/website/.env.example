# Set to the public, signed Mac installer URL once a release is available.
VITE_OPENKLACK_MAC_DOWNLOAD_URL=
VITE_OPENREACTION_MAC_DOWNLOAD_URL=

# Dodo Payments static checkout. Product IDs are public (they appear in every
# checkout link); no Dodo API key belongs here. "Buy" is unavailable unless
# the app's paid product ID is set and it is on sale. Trials start in the
# app, so there is no trial product.
# Leave the origin unset for live; use https://test.checkout.dodopayments.com
# with test-mode product IDs in previews.
VITE_DODO_CHECKOUT_ORIGIN=
VITE_OPENREACTION_DODO_PAID_PRODUCT_ID=
VITE_OPENKLACK_DODO_PAID_PRODUCT_ID=
