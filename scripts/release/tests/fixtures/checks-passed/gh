#!/usr/bin/env bash
# A stand-in for `gh api` and `gh run download` that answers from the
# fixture case named by CHECKS_FIXTURE_CASE: the workflow's run listing
# (by commit or by branch alike) from runs-<workflow>.json, an empty
# listing when the file is absent; a run's jobs from jobs-<id>.json; a
# run's `preflight` artifact from plan-<id>.txt, or no artifact when that
# is absent. A case holding a file named FAIL answers nothing, like an API
# that is down. Only the repository the test names is served.
set -euo pipefail
case_dir="$(cd "$(dirname "$0")" && pwd)/${CHECKS_FIXTURE_CASE:?}"
[[ -e "$case_dir/FAIL" ]] && { echo "fake gh: HTTP 503" >&2; exit 1; }
if [[ "${1:-}" == run && "${2:-}" == download ]]; then
    # gh run download <id> --repo <repo> -n preflight -D <dir>
    id="${3:?}"; shift 3
    dir=""; name=""; repo=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo) repo="$2"; shift 2 ;;
            -n) name="$2"; shift 2 ;;
            -D) dir="$2"; shift 2 ;;
            *) echo "fake gh: unexpected download option $1" >&2; exit 1 ;;
        esac
    done
    [[ "$repo" == openappshq/openapps && "$name" == preflight && -n "$dir" ]] || { echo "fake gh: unexpected download request" >&2; exit 1; }
    [[ -f "$case_dir/plan-$id.txt" ]] || { echo "fake gh: no artifact matches preflight" >&2; exit 1; }
    mkdir -p "$dir" && cp "$case_dir/plan-$id.txt" "$dir/plan.txt"
    exit 0
fi
[[ "${1:-}" == api ]] || { echo "fake gh: only 'gh api' and 'gh run download' are supported" >&2; exit 64; }
path="${2:?}"
case "$path" in
    repos/openappshq/openapps/actions/workflows/*/runs\?*)
        workflow="${path#repos/openappshq/openapps/actions/workflows/}"
        workflow="${workflow%%/*}"
        if [[ -f "$case_dir/runs-$workflow.json" ]]; then cat "$case_dir/runs-$workflow.json"; else echo '{"total_count": 0, "workflow_runs": []}'; fi ;;
    repos/openappshq/openapps/actions/runs/*/jobs\?*)
        id="${path#repos/openappshq/openapps/actions/runs/}"
        id="${id%%/*}"
        [[ -f "$case_dir/jobs-$id.json" ]] || { echo "fake gh: HTTP 404 for run $id" >&2; exit 1; }
        cat "$case_dir/jobs-$id.json" ;;
    *) echo "fake gh: unexpected request $path" >&2; exit 1 ;;
esac
